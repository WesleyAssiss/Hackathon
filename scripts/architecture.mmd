flowchart TD
    U1["🖥️ War Room\nBrowser"]:::client
    U2["🤖 Discord Bot\n/debate"]:::client

    GRD1["🛡️ Injection Guard #1\nHTTP boundary"]
    EP["FastAPI  ·  POST /debates\nSSE Stream"]
    ORCH["⚙️ Orchestrator  ·  PCDR-Loop\nasyncio fan-out  ·  early-stop H < 0.35"]

    subgraph AGENTS["5-Agent Synthetic Council"]
