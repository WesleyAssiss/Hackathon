# =============================================================================
# AURA — variáveis de ambiente (modelo)
# =============================================================================
# 1. Copie:    cp .env.example .env       (Windows: Copy-Item .env.example .env)
# 2. Preencha apenas o BLOCO do modo escolhido (mock / free / azure).
# 3. NUNCA commite o .env — o .gitignore já bloqueia.
# =============================================================================


# -----------------------------------------------------------------------------
# MODO  (mock | free | azure)
# -----------------------------------------------------------------------------
# mock  → 100% offline, deterministic, ZERO chamada externa. Use em CI e ensaios.
# free  → GitHub Models (gratuito com PAT do GitHub). Recomendado para demo.
# azure → Azure OpenAI + Azure AI Search (paga, mas dentro do crédito free de US$200).
AURA_MODE=free


# =============================================================================
# MODO "free" — GitHub Models  (RECOMENDADO — 100% grátis)
# =============================================================================
# 1. Acesse:   https://github.com/settings/tokens
# 2. Clique em "Generate new token (classic)"
# 3. Nome:     "AURA Hackathon"
# 4. Escopo:   nenhum precisa ser marcado (Models API aceita PAT vazio)
# 5. Copie o token (começa com ghp_...) e cole abaixo.
GITHUB_TOKEN=

# Modelo a usar (free tier). Opções: gpt-4o-mini, gpt-4o, Llama-3.3-70B-Instruct,
# Phi-3.5-MoE-instruct, Mistral-large-2407, etc. Lista completa:
#   https://github.com/marketplace?type=models
AURA_GH_MODEL=gpt-4o-mini

# Endpoint (deixe o default — só altere se a Microsoft mudar)
AURA_GH_ENDPOINT=https://models.inference.ai.azure.com

# Modelo de embeddings para re-ranking (opcional, mesma chave GITHUB_TOKEN)
AURA_GH_EMBED_MODEL=text-embedding-3-small


# =============================================================================
# MODO "azure" — apenas se quiser usar Azure OpenAI/Search reais
# =============================================================================
# Endpoint do recurso AOAI (ex: https://aura-aoai-xxxx.openai.azure.com/)
AURA_AOAI_ENDPOINT=
AURA_AOAI_DEPLOYMENT=gpt-4.1
AURA_AOAI_API_VERSION=2024-10-21

# Endpoint do Azure AI Search (ex: https://aura-search-xxxx.search.windows.net)
AURA_FOUNDRY_PROJECT_ENDPOINT=
AURA_FOUNDRY_KNOWLEDGE_INDEX=aura-corpus

# true → usa Managed Identity (Container Apps) ou AzureCliCredential (local).
# false → usa chaves abaixo (só se sua subscription não permite MI).
AURA_USE_MANAGED_IDENTITY=true
AZURE_OPENAI_API_KEY=
AZURE_SEARCH_API_KEY=


# =============================================================================
# Observability  (opcional — App Insights, faz parte do "azure" path)
# =============================================================================
APPLICATIONINSIGHTS_CONNECTION_STRING=


# =============================================================================
# Discord Bot  (opcional — 100% grátis)
# =============================================================================
# 1. Crie um app: https://discord.com/developers/applications  →  New Application
# 2. Vá em "Bot" → Reset Token → copie e cole aqui.
DISCORD_BOT_TOKEN=
AURA_API_BASE=http://localhost:8000


# =============================================================================
# Dados sintéticos
# =============================================================================
# Diretório com .jsonl por persona. Vazio = usa data/synthetic/ automaticamente.
AURA_CORPUS_DIR=
